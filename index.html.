<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
// ── STORAGE HELPERS ──
function getCodes() { try { return JSON.parse(localStorage.getItem('gr_codes') || '{}'); } catch(e) { return {}; } }
function saveCodes(c) { localStorage.setItem('gr_codes', JSON.stringify(c)); }
function getSettings() { try { return JSON.parse(localStorage.getItem('gr_settings') || '{}'); } catch(e) { return {}; } }
function saveSettings() {
  const s = { apiKey: document.getElementById('admin-api-key').value, prompt: document.getElementById('admin-prompt').value };
  localStorage.setItem('gr_settings', JSON.stringify(s));
}

// ── ADMIN ──
function openAdmin() { document.getElementById('admin-modal').classList.add('open'); document.getElementById('admin-pass').value = ''; document.getElementById('pass-error').style.display = 'none'; }
function closeAdmin() { document.getElementById('admin-modal').classList.remove('open'); adminLogout(); }
function checkAdminPass() {
  if (document.getElementById('admin-pass').value === 'Johnny22') {
    document.getElementById('admin-login').style.display = 'none';
    document.getElementById('admin-panel').style.display = 'block';
    loadAdminPanel();
  } else {
    document.getElementById('pass-error').style.display = 'block';
  }
}
function adminLogout() {
  document.getElementById('admin-login').style.display = 'block';
  document.getElementById('admin-panel').style.display = 'none';
}
function loadAdminPanel() {
  const s = getSettings();
  if (s.apiKey) document.getElementById('admin-api-key').value = s.apiKey;
  if (s.prompt) document.getElementById('admin-prompt').value = s.prompt;
  renderCodes();
}
function generateCode() {
  const code = Array.from({length:10}, () => Math.floor(Math.random()*10)).join('');
  const codes = getCodes();
  codes[code] = { uses: 0, created: new Date().toISOString() };
  saveCodes(codes);
  renderCodes();
}
function renderCodes() {
  const codes = getCodes();
  const list = document.getElementById('codes-list');
  const entries = Object.entries(codes).reverse();
  if (entries.length === 0) { list.innerHTML = '<p style="font-size:0.8rem;color:var(--text-muted);margin-top:0.8rem;">No codes generated yet.</p>'; return; }
  list.innerHTML = entries.map(([code, data]) => {
    const remaining = 3 - data.uses;
    const cls = remaining === 0 ? 'dead' : remaining === 1 ? 'warn' : '';
    const label = remaining === 0 ? 'EXPIRED' : `${remaining} use${remaining!==1?'s':''} left`;
    return `<div class="code-chip">
      <span>${code.replace(/(\d{5})(\d{5})/, '$1 $2')}</span>
      <span class="uses ${cls}">${label}</span>
      <button class="code-copy" onclick="copyCode('${code}')">Copy</button>
    </div>`;
  }).join('');
}
function copyCode(code) {
  navigator.clipboard.writeText(code).then(() => alert(`Code ${code} copied!`));
}

// ── CLIENT CODE VERIFICATION ──
let currentCode = null;
function verifyCode() {
  const input = document.getElementById('access-code').value.trim();
  const err = document.getElementById('code-error');
  const codes = getCodes();
  if (!codes[input]) { err.textContent = '❌ Invalid access code. Please contact GreenRock AI.'; err.style.display = 'block'; return; }
  if (codes[input].uses >= 3) { err.textContent = '❌ This code has expired (used 3 times). Please request a new code.'; err.style.display = 'block'; return; }
  currentCode = input;
  err.style.display = 'none';
  document.getElementById('code-entry').style.display = 'none';
  document.getElementById('upload-area').style.display = 'block';
  updateUsesBadge();
}
function updateUsesBadge() {
  const codes = getCodes();
  if (!currentCode || !codes[currentCode]) return;
  const remaining = 3 - codes[currentCode].uses;
  document.getElementById('uses-badge').innerHTML = `Access code: <span>${remaining} analysis use${remaining!==1?'s':''} remaining</span>`;
}

// ── FILE HANDLING ──
let uploadedFile = null;
function handleFile(files) {
  if (!files.length) return;
  uploadedFile = files[0];
  document.getElementById('file-display').innerHTML = `
    <div class="file-item">
      <span>📊</span>
      <span class="file-item-name">${uploadedFile.name}</span>
      <span class="file-item-size">${(uploadedFile.size/1024).toFixed(1)} KB</span>
      <button class="file-remove" onclick="clearFile()">✕</button>
    </div>`;
  document.getElementById('run-btn').disabled = false;
  document.getElementById('result-area').style.display = 'none';
  document.getElementById('error-box').style.display = 'none';
}
function clearFile() {
  uploadedFile = null;
  document.getElementById('file-display').innerHTML = '';
  document.getElementById('run-btn').disabled = true;
}

const dz = document.getElementById('drop-zone');
dz.addEventListener('dragover', e => { e.preventDefault(); dz.classList.add('dragover'); });
dz.addEventListener('dragleave', () => dz.classList.remove('dragover'));
dz.addEventListener('drop', e => { e.preventDefault(); dz.classList.remove('dragover'); handleFile(e.dataTransfer.files); });

// ── READ FILE ──
function readFileAsText(file) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    if (file.name.toLowerCase().endsWith('.csv')) {
      reader.onload = e => resolve(e.target.result);
      reader.onerror = reject;
      reader.readAsText(file);
    } else {
      reader.onload = e => {
        try {
          const wb = XLSX.read(new Uint8Array(e.target.result), { type: 'array' });
          let text = '';
          wb.SheetNames.forEach(sn => { text += `Sheet: ${sn}\n${XLSX.utils.sheet_to_csv(wb.Sheets[sn])}\n\n`; });
          resolve(text);
        } catch(err) { reject(err); }
      };
      reader.onerror = reject;
      reader.readAsArrayBuffer(file);
    }
  });
}

// ── RUN ANALYSIS ──
let lastResult = '';
async function runAnalysis() {
  const s = getSettings();
  const errorBox = document.getElementById('error-box');
  const runBtn = document.getElementById('run-btn');
  const resultArea = document.getElementById('result-area');
  errorBox.style.display = 'none';
  resultArea.style.display = 'none';
  if (!s.apiKey) { errorBox.textContent = '⚠️ No API key configured. Please ask your GreenRock AI administrator.'; errorBox.style.display = 'block'; return; }
  if (!uploadedFile) { errorBox.textContent = '⚠️ Please upload a file first.'; errorBox.style.display = 'block'; return; }
  runBtn.disabled = true; runBtn.textContent = '⏳ ANALYSING...';
  try {
    const fileText = await readFileAsText(uploadedFile);
    const truncated = fileText.length > 30000 ? fileText.substring(0, 30000) + '\n[Data truncated...]' : fileText;
    const prompt = s.prompt || 'Analyse this data file and provide a summary.';
    const response = await fetch('https://api.openai.com/v1/chat/completions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${s.apiKey}` },
      body: JSON.stringify({
        model: 'gpt-4o', max_tokens: 2000,
        messages: [{ role: 'user', content: `${prompt}\n\nFile: "${uploadedFile.name}"\n\n${truncated}` }]
      })
    });
    const data = await response.json();
    if (!response.ok) throw new Error(data.error?.message || 'API error');
    lastResult = data.choices[0].message.content;
    // Use one analysis credit
    const codes = getCodes();
    codes[currentCode].uses++;
    saveCodes(codes);
    updateUsesBadge();
    document.getElementById('result-content').textContent = lastResult;
    resultArea.style.display = 'block';
    resultArea.scrollIntoView({ behavior: 'smooth' });
  } catch(err) {
    errorBox.textContent = `❌ Error: ${err.message}`;
    errorBox.style.display = 'block';
  } finally {
    runBtn.disabled = false; runBtn.textContent = '▶ RUN AI ANALYSIS';
  }
}

// ── PDF DOWNLOAD ──
function downloadPDF() {
  if (!lastResult) return;
  const win = window.open('', '_blank');
  win.document.write(`<!DOCTYPE html><html><head><title>GreenRock AI Report</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 800px; margin: 40px auto; padding: 2rem; color: #111; }
    h1 { color: #007ba7; font-size: 1.4rem; border-bottom: 2px solid #007ba7; padding-bottom: 0.5rem; }
    pre { white-space: pre-wrap; font-size: 0.9rem; line-height: 1.7; margin-top: 1.5rem; }
    .meta { font-size: 0.8rem; color: #666; margin-top: 0.5rem; }
    .footer { margin-top: 3rem; border-top: 1px solid #ccc; padding-top: 1rem; font-size: 0.75rem; color: #999; }
  </style></head><body>
  <h1>GreenRock AI — Analysis Report</h1>
  <p class="meta">File: ${uploadedFile ? uploadedFile.name : 'N/A'} &nbsp;|&nbsp; Generated: ${new Date().toLocaleString()}</p>
  <pre>${lastResult}</pre>
  <div class="footer">GreenRock AI · www.greenrock-ai.com · kimba@greenrock-ai.com · +27 66 299 8028</div>
  <script>window.onload=function(){window.print();}<\/script>
  </body></html>`);
  win.document.close();
}

function resetUpload() {
  clearFile();
  document.getElementById('result-area').style.display = 'none';
  document.getElementById('error-box').style.display = 'none';
  lastResult = '';
}
</script>
</body>
</html>
