<style>
:root {
  --blue-deep: #020b18;
  --blue-dark: #041428;
  --blue-mid: #0a2a4a;
  --blue-bright: #00b4d8;
  --blue-glow: #48cae4;
  --blue-pale: #90e0ef;
  --cyan: #00f5ff;
  --gold: #f0c040;
  --surface: #071e33;
  --surface2: #0d2a42;
  --text: #e0f4ff;
  --text-muted: #5a8fa8;
  --border: rgba(0,180,216,0.15);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: 'Exo 2', sans-serif;
  background: var(--blue-deep);
  color: var(--text);
  overflow-x: hidden;
  min-height: 100vh;
}

/* Animated background */
.bg-grid {
  position: fixed; inset: 0; z-index: 0; pointer-events: none;
  background-image:
    linear-gradient(rgba(0,180,216,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,180,216,0.03) 1px, transparent 1px);
  background-size: 50px 50px;
  animation: gridScroll 25s linear infinite;
}
@keyframes gridScroll { to { transform: translateY(50px); } }

.bg-orb {
  position: fixed; border-radius: 50%; filter: blur(80px);
  pointer-events: none; z-index: 0;
}
.orb1 { width: 500px; height: 500px; background: rgba(0,180,216,0.06); top: -100px; right: -100px; animation: orbFloat 15s ease-in-out infinite; }
.orb2 { width: 400px; height: 400px; background: rgba(0,245,255,0.04); bottom: 10%; left: -100px; animation: orbFloat 20s 5s ease-in-out infinite reverse; }
@keyframes orbFloat {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(40px) scale(1.1); }
}

/* NAV */
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  display: flex; align-items: center; justify-content: space-between;
  padding: 1rem 3rem;
  background: rgba(2,11,24,0.9);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border);
}
.logo {
  font-family: 'Orbitron', monospace;
  font-weight: 900; font-size: 1.2rem;
  color: var(--text); text-decoration: none;
  letter-spacing: 0.05em;
}
.logo span { color: var(--blue-bright); }
.nav-links { display: flex; gap: 2rem; list-style: none; }
.nav-links a { color: var(--text-muted); text-decoration: none; font-size: 0.85rem; font-weight: 500; transition: color 0.2s; letter-spacing: 0.05em; }
.nav-links a:hover { color: var(--blue-bright); }
.nav-admin { background: transparent; border: 1px solid var(--border); color: var(--text-muted); padding: 0.45rem 1rem; border-radius: 6px; font-size: 0.78rem; cursor: pointer; font-family: 'Exo 2', sans-serif; transition: all 0.2s; }
.nav-admin:hover { border-color: var(--blue-bright); color: var(--blue-bright); }

/* HERO */
#hero {
  min-height: 100vh;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  text-align: center;
  padding: 8rem 2rem 4rem;
  position: relative; z-index: 1;
}
.hero-badge {
  display: inline-flex; align-items: center; gap: 0.5rem;
  background: rgba(0,180,216,0.08);
  border: 1px solid rgba(0,180,216,0.25);
  border-radius: 100px;
  padding: 0.4rem 1.2rem;
  font-size: 0.75rem; font-weight: 500;
  color: var(--blue-bright);
  letter-spacing: 0.15em; text-transform: uppercase;
  margin-bottom: 2rem;
  animation: fadeUp 0.8s ease both;
}
.badge-pulse { width: 6px; height: 6px; border-radius: 50%; background: var(--cyan); animation: pulse 2s infinite; }
@keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.4;transform:scale(0.6)} }

h1 {
  font-family: 'Orbitron', monospace;
  font-size: clamp(2.2rem, 6vw, 4.5rem);
  font-weight: 900;
  line-height: 1.1;
  margin-bottom: 1.5rem;
  animation: fadeUp 0.8s 0.2s ease both;
}
h1 .accent { color: var(--blue-bright); }
h1 .gold { color: var(--gold); }

.hero-sub {
  font-size: 1.05rem; color: var(--text-muted);
  line-height: 1.8; max-width: 580px; margin: 0 auto 3rem;
  animation: fadeUp 0.8s 0.4s ease both;
}

/* Globe visual */
.globe-wrap {
  position: relative; width: 260px; height: 260px; margin: 0 auto 3rem;
  animation: fadeUp 0.8s 0.6s ease both;
}
.globe {
  width: 100%; height: 100%;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #0d4a7a, #020b18);
  border: 1px solid rgba(0,180,216,0.3);
  box-shadow: 0 0 60px rgba(0,180,216,0.15), inset 0 0 40px rgba(0,180,216,0.05);
  position: relative; overflow: hidden;
}
.globe::before {
  content: '';
  position: absolute; inset: 0;
  background: repeating-linear-gradient(0deg, transparent, transparent 18px, rgba(0,180,216,0.05) 18px, rgba(0,180,216,0.05) 19px);
}
.globe::after {
  content: '';
  position: absolute; inset: 0;
  background: repeating-linear-gradient(90deg, transparent, transparent 18px, rgba(0,180,216,0.05) 18px, rgba(0,180,216,0.05) 19px);
}
.globe-ring {
  position: absolute; inset: -15px;
  border-radius: 50%;
  border: 1px dashed rgba(0,180,216,0.2);
  animation: spin 20s linear infinite;
}
.globe-ring2 {
  position: absolute; inset: -30px;
  border-radius: 50%;
  border: 1px dashed rgba(0,180,216,0.1);
  animation: spin 30s linear infinite reverse;
}
@keyframes spin { to { transform: rotate(360deg); } }
.globe-dot {
  position: absolute; width: 8px; height: 8px;
  border-radius: 50%; background: var(--cyan);
  box-shadow: 0 0 10px var(--cyan);
  animation: dotPulse 2s ease-in-out infinite;
}
.globe-dot:nth-child(1) { top: 30%; left: 40%; animation-delay: 0s; }
.globe-dot:nth-child(2) { top: 55%; left: 60%; animation-delay: 0.7s; }
.globe-dot:nth-child(3) { top: 70%; left: 35%; animation-delay: 1.4s; }
@keyframes dotPulse { 0%,100%{transform:scale(1);opacity:1} 50%{transform:scale(1.5);opacity:0.6} }

.hero-btn {
  display: inline-flex; align-items: center; gap: 0.5rem;
  background: var(--blue-bright);
  color: var(--blue-deep);
  padding: 0.9rem 2.5rem;
  border-radius: 8px;
  font-family: 'Orbitron', monospace;
  font-weight: 700; font-size: 0.85rem;
  text-decoration: none; letter-spacing: 0.08em;
  transition: all 0.2s;
  box-shadow: 0 4px 30px rgba(0,180,216,0.3);
  animation: fadeUp 0.8s 0.8s ease both;
}
.hero-btn:hover {
  background: var(--cyan);
  box-shadow: 0 4px 40px rgba(0,245,255,0.5);
  transform: translateY(-2px);
}

@keyframes fadeUp { from{opacity:0;transform:translateY(25px)} to{opacity:1;transform:translateY(0)} }

/* SERVICES */
#services {
  padding: 5rem 3rem;
  position: relative; z-index: 1;
  max-width: 1000px; margin: 0 auto;
}
.section-label {
  font-size: 0.72rem; font-weight: 600;
  text-transform: uppercase; letter-spacing: 0.2em;
  color: var(--blue-bright); margin-bottom: 0.8rem; text-align: center;
}
.section-title {
  font-family: 'Orbitron', monospace;
  font-size: clamp(1.5rem, 3vw, 2.2rem);
  font-weight: 700; text-align: center;
  margin-bottom: 3rem; line-height: 1.2;
}
.services-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;
}
.svc-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px; padding: 1.8rem;
  transition: all 0.3s; position: relative; overflow: hidden;
}
.svc-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
  background: linear-gradient(90deg, transparent, var(--blue-bright), transparent);
  opacity: 0; transition: opacity 0.3s;
}
.svc-card:hover { transform: translateY(-4px); border-color: rgba(0,180,216,0.3); box-shadow: 0 10px 40px rgba(0,0,0,0.3); }
.svc-card:hover::before { opacity: 1; }
.svc-icon { font-size: 2rem; margin-bottom: 1rem; }
.svc-card h3 { font-family: 'Orbitron', monospace; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.8rem; color: var(--blue-pale); letter-spacing: 0.05em; }
.svc-card p { font-size: 0.88rem; color: var(--text-muted); line-height: 1.7; }
.svc-tag { display: inline-block; margin-top: 1rem; background: rgba(0,180,216,0.08); border: 1px solid rgba(0,180,216,0.2); border-radius: 100px; padding: 0.2rem 0.8rem; font-size: 0.7rem; color: var(--blue-bright); font-weight: 600; letter-spacing: 0.08em; }

/* MINERALS */
.minerals { text-align: center; padding: 2rem 3rem 5rem; position: relative; z-index: 1; }
.mineral-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.8rem; margin-top: 1.5rem; }
.mchip { background: var(--surface); border: 1px solid var(--border); border-radius: 100px; padding: 0.45rem 1.2rem; font-size: 0.82rem; transition: all 0.2s; cursor: default; }
.mchip:hover { border-color: var(--blue-bright); color: var(--blue-bright); transform: translateY(-2px); }
.mchip .dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 0.4rem; }

/* CLIENT PORTAL */
#portal {
  padding: 5rem 2rem;
  position: relative; z-index: 1;
  max-width: 700px; margin: 0 auto;
}
.portal-box {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 20px; overflow: hidden;
}
.portal-head {
  background: linear-gradient(135deg, var(--blue-mid), var(--surface2));
  padding: 1.8rem 2rem;
  border-bottom: 1px solid var(--border);
  display: flex; align-items: center; gap: 1rem;
}
.portal-head-icon {
  width: 46px; height: 46px;
  background: rgba(0,180,216,0.12);
  border: 1px solid rgba(0,180,216,0.25);
  border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.3rem;
}
.portal-head h3 { font-family: 'Orbitron', monospace; font-size: 1rem; font-weight: 700; letter-spacing: 0.05em; }
.portal-head p { font-size: 0.8rem; color: var(--text-muted); margin-top: 0.2rem; }
.portal-body { padding: 2rem; }

/* Code entry */
.code-entry { text-align: center; }
.code-entry h4 { font-family: 'Orbitron', monospace; font-size: 1rem; font-weight: 700; margin-bottom: 0.5rem; }
.code-entry p { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem; }
.code-input-row { display: flex; gap: 0.5rem; max-width: 380px; margin: 0 auto 1rem; }
.code-input-row input {
  flex: 1; background: var(--blue-deep); border: 1px solid var(--border);
  border-radius: 8px; padding: 0.85rem 1rem;
  color: var(--text); font-family: 'Orbitron', monospace;
  font-size: 1.1rem; letter-spacing: 0.15em; text-align: center;
  outline: none; transition: border-color 0.2s;
}
.code-input-row input:focus { border-color: var(--blue-bright); }
.btn-primary {
  background: var(--blue-bright); color: var(--blue-deep);
  border: none; border-radius: 8px;
  padding: 0.85rem 1.5rem;
  font-family: 'Orbitron', monospace; font-weight: 700; font-size: 0.8rem;
  cursor: pointer; letter-spacing: 0.05em;
  transition: all 0.2s; white-space: nowrap;
}
.btn-primary:hover { background: var(--cyan); box-shadow: 0 4px 20px rgba(0,245,255,0.3); }
.btn-primary:disabled { background: var(--surface2); color: var(--text-muted); cursor: not-allowed; box-shadow: none; }

/* Upload area */
#upload-area { display: none; }
.upload-zone {
  border: 2px dashed rgba(0,180,216,0.25);
  border-radius: 12px; padding: 2.5rem 1.5rem;
  text-align: center; cursor: pointer;
  transition: all 0.3s; position: relative;
  background: rgba(0,180,216,0.02);
}
.upload-zone:hover, .upload-zone.dragover { border-color: var(--blue-bright); background: rgba(0,180,216,0.05); }
.upload-zone input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
.upload-icon { font-size: 2.5rem; margin-bottom: 0.8rem; }
.upload-zone h4 { font-family: 'Orbitron', monospace; font-size: 0.9rem; margin-bottom: 0.4rem; }
.upload-zone p { font-size: 0.82rem; color: var(--text-muted); }
.file-badges { display: flex; gap: 0.4rem; justify-content: center; margin-top: 1rem; flex-wrap: wrap; }
.fbadge { background: rgba(0,180,216,0.1); border: 1px solid rgba(0,180,216,0.2); border-radius: 4px; padding: 0.15rem 0.5rem; font-size: 0.68rem; color: var(--blue-bright); font-weight: 600; }

.file-item {
  display: flex; align-items: center; gap: 0.8rem;
  background: var(--blue-deep); border: 1px solid var(--border);
  border-radius: 8px; padding: 0.7rem 1rem; margin-top: 1rem;
}
.file-item-name { flex: 1; font-size: 0.88rem; }
.file-item-size { font-size: 0.75rem; color: var(--text-muted); }
.file-remove { background: rgba(255,80,80,0.1); border: 1px solid rgba(255,80,80,0.2); border-radius: 5px; color: #ff8080; width: 26px; height: 26px; cursor: pointer; font-size: 0.8rem; display: flex; align-items: center; justify-content: center; transition: background 0.2s; }
.file-remove:hover { background: rgba(255,80,80,0.2); }

.run-btn {
  width: 100%; background: var(--blue-bright); color: var(--blue-deep);
  border: none; border-radius: 10px; padding: 1rem;
  font-family: 'Orbitron', monospace; font-weight: 700; font-size: 0.85rem;
  cursor: pointer; margin-top: 1.2rem; letter-spacing: 0.08em;
  transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 0.5rem;
}
.run-btn:hover { background: var(--cyan); box-shadow: 0 4px 25px rgba(0,245,255,0.3); }
.run-btn:disabled { background: var(--surface2); color: var(--text-muted); cursor: not-allowed; box-shadow: none; }

.uses-badge {
  text-align: center; margin-top: 1rem;
  font-size: 0.75rem; color: var(--text-muted);
}
.uses-badge span { color: var(--gold); font-weight: 600; }

/* Results / PDF */
#result-area { display: none; margin-top: 1.5rem; }
.result-box {
  background: var(--blue-deep); border: 1px solid var(--border);
  border-radius: 10px; padding: 1.5rem;
  font-size: 0.88rem; line-height: 1.8;
  white-space: pre-wrap; color: var(--text);
  max-height: 400px; overflow-y: auto;
}
.result-actions { display: flex; gap: 0.8rem; margin-top: 1rem; }
.btn-outline {
  flex: 1; background: transparent; border: 1px solid var(--blue-bright);
  color: var(--blue-bright); border-radius: 8px; padding: 0.75rem;
  font-family: 'Orbitron', monospace; font-size: 0.75rem; font-weight: 700;
  cursor: pointer; letter-spacing: 0.05em; transition: all 0.2s;
}
.btn-outline:hover { background: rgba(0,180,216,0.1); }

#error-box { display: none; margin-top: 1rem; background: rgba(255,80,80,0.08); border: 1px solid rgba(255,80,80,0.2); border-radius: 8px; padding: 1rem; color: #ff8080; font-size: 0.85rem; }

/* CONTACT */
#contact {
  padding: 5rem 3rem;
  position: relative; z-index: 1;
  max-width: 800px; margin: 0 auto;
  text-align: center;
}
.contact-grid { display: flex; justify-content: center; gap: 2rem; flex-wrap: wrap; margin-top: 2.5rem; }
.citem {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: 12px; padding: 1.5rem 2rem;
  min-width: 180px; transition: all 0.2s;
}
.citem:hover { border-color: rgba(0,180,216,0.3); transform: translateY(-3px); }
.citem-icon { font-size: 1.5rem; margin-bottom: 0.6rem; }
.citem-label { font-size: 0.68rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 0.3rem; }
.citem-val { font-size: 0.88rem; font-weight: 500; }
.citem-val a { color: var(--blue-bright); text-decoration: none; }
.citem-val a:hover { color: var(--cyan); }

/* FOOTER */
footer {
  border-top: 1px solid var(--border);
  padding: 1.5rem 3rem;
  display: flex; align-items: center; justify-content: space-between;
  flex-wrap: wrap; gap: 1rem;
  position: relative; z-index: 1;
}
footer p { font-size: 0.78rem; color: var(--text-muted); }

/* ADMIN MODAL */
.modal-overlay {
  display: none; position: fixed; inset: 0; z-index: 200;
  background: rgba(2,11,24,0.95);
  backdrop-filter: blur(10px);
  align-items: center; justify-content: center;
}
.modal-overlay.open { display: flex; }
.modal {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 20px; padding: 2.5rem;
  width: 100%; max-width: 560px;
  max-height: 90vh; overflow-y: auto;
  position: relative;
}
.modal-close {
  position: absolute; top: 1rem; right: 1rem;
  background: var(--surface2); border: 1px solid var(--border);
  border-radius: 8px; color: var(--text-muted);
  width: 32px; height: 32px; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  font-size: 1rem; transition: all 0.2s;
}
.modal-close:hover { color: var(--text); border-color: var(--blue-bright); }
.modal h2 { font-family: 'Orbitron', monospace; font-size: 1.1rem; font-weight: 700; margin-bottom: 0.3rem; }
.modal-sub { font-size: 0.82rem; color: var(--text-muted); margin-bottom: 2rem; }

.form-group { margin-bottom: 1.2rem; }
.form-group label { display: block; font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.4rem; font-weight: 600; }
.form-group input, .form-group textarea {
  width: 100%; background: var(--blue-deep);
  border: 1px solid var(--border); border-radius: 8px;
  padding: 0.75rem 1rem; color: var(--text);
  font-family: 'Exo 2', sans-serif; font-size: 0.9rem;
  outline: none; transition: border-color 0.2s;
}
.form-group input:focus, .form-group textarea:focus { border-color: var(--blue-bright); }
.form-group textarea { resize: vertical; min-height: 100px; }
.form-group input[type="password"] { font-family: monospace; letter-spacing: 0.1em; }

.admin-section { margin-bottom: 2rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border); }
.admin-section:last-child { border-bottom: none; margin-bottom: 0; }
.admin-section h3 { font-family: 'Orbitron', monospace; font-size: 0.85rem; font-weight: 700; margin-bottom: 1rem; color: var(--blue-pale); letter-spacing: 0.05em; }

.generated-codes { margin-top: 1rem; }
.code-chip {
  display: flex; align-items: center; justify-content: space-between;
  background: var(--blue-deep); border: 1px solid var(--border);
  border-radius: 8px; padding: 0.6rem 1rem; margin-bottom: 0.5rem;
  font-family: 'Orbitron', monospace; font-size: 0.85rem;
}
.code-chip .uses { font-size: 0.7rem; color: var(--text-muted); }
.code-chip .uses.warn { color: var(--gold); }
.code-chip .uses.dead { color: #ff6060; }
.code-copy { background: rgba(0,180,216,0.1); border: 1px solid rgba(0,180,216,0.2); border-radius: 5px; color: var(--blue-bright); padding: 0.2rem 0.6rem; font-size: 0.7rem; cursor: pointer; transition: background 0.2s; font-family: 'Exo 2', sans-serif; }
.code-copy:hover { background: rgba(0,180,216,0.2); }

#admin-login { }
#admin-panel { display: none; }

@media (max-width: 700px) {
  nav { padding: 1rem 1.2rem; }
  .nav-links { display: none; }
  #services, #contact, #portal { padding: 4rem 1.2rem; }
  .services-grid { grid-template-columns: 1fr; }
  footer { padding: 1.2rem; flex-direction: column; text-align: center; }
}
</style>
</head>
<body>

<div class="bg-grid"></div>
<div class="bg-orb orb1"></div>
<div class="bg-orb orb2"></div>

<!-- NAV -->
<nav>
  <a href="#" class="logo">Green<span>Rock</span> AI</a>
  <ul class="nav-links">
    <li><a href="#services">Services</a></li>
    <li><a href="#portal">Platform</a></li>
    <li><a href="#contact">Contact</a></li>
  </ul>
  <button class="nav-admin" onclick="openAdmin()">Admin ⚙</button>
